<Page x:Class="Clipboard.Desktop.Views.Pages.ContentPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Clipboard.Desktop.Views.Pages" xmlns:enums="clr-namespace:Clipboard.Data.Enums;assembly=Clipboard.Data" xmlns:usrControl="clr-namespace:Clipboard.Desktop.Views.Controls" xmlns:hc="https://handyorg.github.io/handycontrol" Title="ContentPage" DataContext="{Binding Source={StaticResource Locator}, Path=ContentPageViewModel}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <CollectionViewSource x:Key="DataTypeListCollectionSource" Source="{Binding Path=CommonViewModel.ClipboardDataCollection, Source={StaticResource Locator}}" Filter="CollectionViewSource_Filter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="340" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Border CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16,4">
        <Grid>
          <StackPanel Orientation="Horizontal" Height="28">
            <CheckBox IsChecked="{Binding SearchTextBoxVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Path=IsChecked, Converter={StaticResource Boolean2VisibilityReConverter}, RelativeSource={RelativeSource Mode=Self}}" Checked="SearchCheckBox_Checked">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type CheckBox}">
                  <Setter Property="Width" Value="24" />
                  <Setter Property="Height" Value="24" />
                  <Setter Property="Foreground" Value="#666666" />
                  <Setter Property="Background" Value="#00FFFFFF" />
                  <Setter Property="FontSize" Value="14" />
                  <Setter Property="Padding" Value="16,0" />
                  <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate>
                        <Border Padding="5" CornerRadius="4" BorderThickness="0" Background="{TemplateBinding Control.Background}">
                          <Path StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Data="M6.22222222,12.4444444 C9.65866067,12.4444444 12.4444444,9.65866067 12.4444444,6.22222222 C12.4444444,2.78578378 9.65866067,0 6.22222222,0 C2.78578378,0 0,2.78578378 0,6.22222222 C0,9.65866067 2.78578378,12.4444444 6.22222222,12.4444444 M14,14 L10.6166667,10.6166667" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=CheckBox}}" />
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#1A000000" />
                    </Trigger>
                    <Trigger Property="UIElement.IsMouseCaptured" Value="True">
                      <Setter Property="Background" Value="#1A000000" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Foreground" Value="#FFFFFF" />
                      <Setter Property="Background" Value="#66000000" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </CheckBox>
            <Border Margin="8,0" Height="28" CornerRadius="4" Width="320" Visibility="{Binding SearchTextBoxVisible, Converter={StaticResource Boolean2VisibilityConverter}}" FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}" MouseEnter="Border_MouseEnter" MouseLeave="Border_MouseLeave">
              <Grid Height="24" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Path StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Stroke="#666666" VerticalAlignment="Center" HorizontalAlignment="Center" Data="M6.22222222,12.4444444 C9.65866067,12.4444444 12.4444444,9.65866067 12.4444444,6.22222222 C12.4444444,2.78578378 9.65866067,0 6.22222222,0 C2.78578378,0 0,2.78578378 0,6.22222222 C0,9.65866067 2.78578378,12.4444444 6.22222222,12.4444444 M14,14 L10.6166667,10.6166667" />
                </Border>
                <TextBox x:Name="SearchTextBox" Padding="0" Grid.Column="1" BorderThickness="0" VerticalAlignment="Center" Background="#00FFFFFF" Text="{Binding SearchFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="SearchTextBox_LostFocus" TextChanged="SearchTextBox_TextChanged" />
                <TextBlock Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0" Text="{DynamicResource ClipboardDataSearchText_PlaceHolder}" FontSize="14" Foreground="#FF666666" Visibility="{Binding ElementName=SearchTextBox, Path=Text, Converter={StaticResource String2VisibilityReConverter}}" />
                <Button Grid.Column="2" BorderThickness="0" Command="{Binding Path=DataContext.ClearSearchButtonClickedCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:ContentPage}}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Button}">
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate>
                            <Border CornerRadius="0,1,1,0" Background="{TemplateBinding Control.Background}">
                              <Border Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Stroke="#666666" VerticalAlignment="Center" HorizontalAlignment="Center" Data="M12,19 C15.8659932,19 19,15.8659932 19,12 C19,8.13400675 15.8659932,5 12,5 C8.13400675,5 5,8.13400675 5,12 C5,15.8659932 8.13400675,19 12,19 M14.1,9.9 L9.9,14.1 M9.9,9.9 L14.1,14.1" />
                              </Border>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#1A000000" />
                        </Trigger>
                        <Trigger Property="UIElement.IsMouseCaptured" Value="True">
                          <Setter Property="Background" Value="#2A000000" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Button>
              </Grid>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="Border.CornerRadius" Value="4" />
                  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="#757575" />
                    </Trigger>
                    <DataTrigger Value="True" Binding="{Binding ElementName=SearchTextBox, Path=IsFocused}">
                      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Border>
            <RadioButton x:Name="History_RadioButton" Style="{StaticResource ClipboardDataTagRadioButton}" GroupName="TagRadioButton" Margin="8,0,0,0" IsChecked="True" Content="{DynamicResource ClipboardDataTag_History}" hc:IconElement.Width="14" hc:IconElement.Height="14" hc:IconElement.Geometry="M0,7 A7,7 0 1 0 14,7A7,7 0 1 0 0,7M7,2.8 L7,7 L9.8,8.4" DataContext="{Binding SearchTextBoxVisible, Converter={StaticResource Boolean2VisibilityReConverter}}" Checked="History_RadioButton_Checked">
              <FrameworkElement.ContextMenu>
                <ContextMenu Background="#F4DDDCDC" Padding="0" Margin="0" BorderThickness="0">
                  <MenuItem Margin="0" FontSize="14" BorderThickness="0,2" BorderBrush="#33FFFFFF" Padding="0" Foreground="#FF333333" Header="{DynamicResource History_RadioButton_ClearHistory}" Click="MenuItem_Click" />
                </ContextMenu>
              </FrameworkElement.ContextMenu>
            </RadioButton>
            <RadioButton x:Name="Favorite_RadioButton" Style="{StaticResource ClipboardDataTagRadioButton}" GroupName="TagRadioButton" Margin="8,0,0,0" Content="{DynamicResource ClipboardDataTag_Favorite}" hc:IconElement.Width="14" hc:IconElement.Height="14" hc:IconElement.Geometry="M12,5 L14.163,9.27865405 L19,9.96898002 L15.5,13.2975815 L16.326,18 L12,15.778654 L7.674,18 L8.5,13.2975815 L5,9.96898002 L9.837,9.27865405" DataContext="{Binding SearchTextBoxVisible, Converter={StaticResource Boolean2VisibilityReConverter}}" Checked="Favorite_RadioButton_Checked" />
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="24,0">
        <ToggleButton x:Name="MenuToggleButton" Background="#00FFFFFF" BorderThickness="0" Padding="10" hc:Poptip.HitMode="None" hc:Poptip.IsOpen="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ToggleButton}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate>
                    <Border Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#00FFFFFF">
                      <Path Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="#666666" Stroke="#666666" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M7,1 A1,1 0 1 0 9,1A1,1 0 1 0 7,1M14,1 A1,1 0 1 0 16,1A1,1 0 1 0 14,1M0,1 A1,1 0 1 0 2,1A1,1 0 1 0 0,1" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </FrameworkElement.Style>
        </ToggleButton>
        <Popup StaysOpen="False" VerticalOffset="8" AllowsTransparency="True" Placement="Bottom" IsOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalOffset="{Binding ElementName=MenuToggleButtonContent, Path=ActualWidth, Mode=OneWay, Converter={StaticResource OppositeConverter}, ConverterParameter=24}" PlacementTarget="{Binding ElementName=MenuToggleButton}">
          <Border x:Name="MenuToggleButtonContent" CornerRadius="0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#F4DDDCDC" Margin="5" BorderThickness="0" MinWidth="78" MinHeight="54" Padding="0" Style="{StaticResource BorderRegion}" Effect="{StaticResource EffectShadow3}">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseStyle}">
                    <Setter Property="Background" Value="#33FFFFFF" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate>
                          <Border Padding="25,5" Background="{TemplateBinding Control.Background}" BorderThickness="1" BorderBrush="#00FFFFFF">
                            <TextBlock FontSize="14" FontWeight="Medium" Foreground="#FF333333" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Path=Content, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EEEEEE" />
                      </Trigger>
                      <Trigger Property="UIElement.IsMouseCaptured" Value="True">
                        <Setter Property="Background" Value="#EEEEEE" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <Button x:Name="Menu_Setting" Content="{DynamicResource ClipboardData_MainWindowMenu_Setting}" Click="Menu_Setting_Click" />
              <Button x:Name="Menu_Exit" Content="{DynamicResource ClipboardData_MainWindowMenu_Exit}" Click="Menu_Exit_Click" />
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </Grid>
    <ListBox x:Name="HistoryListBox" Grid.Row="1" SelectionMode="Extended" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ItemsSource="{Binding Source={StaticResource DataTypeListCollectionSource}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <Control.Template>
        <ControlTemplate>
          <ScrollViewer Style="{StaticResource DefaultScrollViewer}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Control.Template>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}">
          <Setter Property="Width" Value="292" />
          <Setter Property="Height" Value="300" />
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="BorderThickness" Value="4" />
          <Setter Property="BorderBrush" Value="#00FFFFFF" />
          <Setter Property="ListBoxItem.IsSelected" Value="{Binding IsSelected}" />
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Border Margin="12,0" CornerRadius="8" Effect="{StaticResource EffectShadow2}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" FocusVisualStyle="{x:Null}">
                  <usrControl:ClipboardDataControl Background="{TemplateBinding Control.Background}" DataContext="{Binding}" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter Property="BorderBrush" Value="#007aff" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </ItemsControl.ItemContainerStyle>
      <FrameworkElement.ContextMenu>
        <ContextMenu Background="#F4DDDCDC" Padding="0" Margin="0" BorderThickness="0">
          <MenuItem Tag="Copy" Header="{DynamicResource History_Listbox_Copy}" Margin="0" FontSize="14" BorderThickness="0,2" BorderBrush="#33FFFFFF" Padding="0" Foreground="#FF333333" Click="ListBox_MenuItem_Click" />
          <MenuItem Tag="Favorite" Header="{DynamicResource History_Listbox_Favorite}" Margin="0" FontSize="14" BorderThickness="0,2" BorderBrush="#33FFFFFF" Padding="0" Foreground="#FF333333" Click="ListBox_MenuItem_Click" />
          <MenuItem Tag="Delete" Header="{DynamicResource History_Listbox_Delete}" Margin="0" FontSize="14" BorderThickness="0,2" BorderBrush="#33FFFFFF" Padding="0" Foreground="#FF333333" Click="ListBox_MenuItem_Click" />
        </ContextMenu>
      </FrameworkElement.ContextMenu>
    </ListBox>
    <TextBlock x:Name="EmptyHistoryTextBlock" Grid.Row="1" FontWeight="Medium" FontSize="40" Foreground="#66000000" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{DynamicResource ClipboardDataTag_History_Empty}" Visibility="{Binding HasItems, ElementName=HistoryListBox, Converter={StaticResource Boolean2VisibilityReConverter}}" />
  </Grid>
</Page>