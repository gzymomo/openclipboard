<Window x:Class="Clipboard.Desktop.Views.Windows.ConfirmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Clipboard.Desktop.Views.Windows" xmlns:interop="clr-namespace:Common.Interop" WindowStyle="None" WindowChrome.IsHitTestVisibleInChrome="False" interop:WindowBlur.IsEnabled="True" Background="#00FFFFFF" Title="ConfirmWindow" Height="190" Width="400">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0,0,0,1" CaptionHeight="0" />
  </WindowChrome.WindowChrome>
  <Grid Background="{DynamicResource GlassTintBrush}">
    <Grid Margin="32">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="72" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>
    <Image Grid.Column="0" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="40" Height="40" Source="Pack://Application:,,,/Clipboard.Desktop;Component/Resources/Images/Logo.png" />
    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1">
      <TextBlock FontSize="16" FontWeight="Medium" Foreground="#FF333333" TextWrapping="Wrap" TextAlignment="Left" Text="{DynamicResource ConfirmWindow_Title_Text}" />
      <TextBlock FontSize="14" FontWeight="Regular" Foreground="#FF666666" TextWrapping="Wrap" TextAlignment="Left" Text="{DynamicResource ConfirmWindow_Content_Text}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1">
      <Button Content="{DynamicResource ConfirmWindow_OK}" Style="{StaticResource ButtonPrimary}" Margin="16,0" Padding="22,0" Click="Button_Click" />
      <Button Content="{DynamicResource ConfirmWindow_Cancel}" Padding="22,0" Click="Button_Click_1" />
    </StackPanel>
    </Grid>
    <Border IsHitTestVisible="False" BorderThickness="1" BorderBrush="#5CFFFFFF" Opacity="{DynamicResource GlassHighlightOpacity}">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Offset="0" Color="#3DFFFFFF" />
          <GradientStop Offset="0.35" Color="#12FFFFFF" />
          <GradientStop Offset="1" Color="#26FFFFFF" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
  </Grid>
</Window>