<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OpenClipboard.App"
        xmlns:services="using:OpenClipboard.App.Services"
        x:Class="OpenClipboard.App.SettingsWindow"
        x:DataType="local:SettingsWindow"
        Title="Settings"
        Icon="avares://OpenClipboard.App/Assets/logo.png"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Width="560"
        Height="620"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Border x:Name="MainBackground" CornerRadius="12" ClipToBounds="True">
    <Grid RowDefinitions="*,Auto" Margin="20,16,20,16" RowSpacing="12">
      <TabControl x:Name="SettingsTabs" TabStripPlacement="Left">
        <TabItem x:Name="GeneralTab">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,4,4,4">
              <Grid ColumnDefinitions="160,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="AutoRunLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="AutoRunCheckBox" VerticalAlignment="Center" Click="AutoRunCheckBox_OnClick" />

                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LanguageLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LanguageBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Languages}" SelectionChanged="LanguageBox_OnSelectionChanged">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:LanguageOption">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="ActivationHotkeyLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ActivationHotkeyBox" HorizontalAlignment="Stretch" IsReadOnly="True" KeyDown="ActivationHotkeyBox_OnKeyDown" />

                <TextBlock Grid.Row="3" Grid.Column="0" x:Name="QuickCopyHotkeyLabel" VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                  <TextBox x:Name="QuickCopyHotkeyBox" HorizontalAlignment="Stretch" IsReadOnly="True" KeyDown="QuickCopyHotkeyBox_OnKeyDown" />
                  <TextBlock x:Name="HotkeyHelpText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" x:Name="HistoryModeLabel" VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap" />
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Slider Grid.Column="0" x:Name="HistoryModeSlider" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="HistoryModeSlider_OnValueChanged" />
                    <TextBlock Grid.Column="1" x:Name="HistoryModeValueText" FontSize="11" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" x:Name="GlassOpacityLabel" VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap" />
                <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Slider Grid.Column="0" x:Name="GlassOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="GlassOpacitySlider_OnValueChanged" />
                    <TextBlock Grid.Column="1" x:Name="GlassOpacityValueText" FontSize="11" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" x:Name="ScrollWheelSpeedLabel" VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap" />
                <StackPanel Grid.Row="6" Grid.Column="1" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Slider Grid.Column="0" x:Name="ScrollWheelSpeedSlider" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ScrollWheelSpeedSlider_OnValueChanged" />
                    <TextBlock Grid.Column="1" x:Name="ScrollWheelSpeedValueText" FontSize="11" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#1A000000" Padding="0,10,0,0">
        <StackPanel Spacing="8">
          <TextBlock x:Name="HotkeyStatusText" Foreground="Tomato" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" x:Name="ClearHistoryButton" CornerRadius="8" Click="ClearHistory_OnClick" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button x:Name="CancelButton" CornerRadius="8" Click="Cancel_OnClick" />
              <Button x:Name="SaveButton" CornerRadius="8" Click="Save_OnClick" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
