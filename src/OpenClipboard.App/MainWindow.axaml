<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OpenClipboard.App"
        xmlns:models="using:OpenClipboard.App.Models"
        x:Class="OpenClipboard.App.MainWindow"
        x:DataType="local:MainWindow"
        Title="OpenClipboard"
        Icon="avares://OpenClipboard.App/Assets/logo.png"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        WindowDecorations="None"
        CanResize="False"
        Width="1000"
        Height="400"
        MinWidth="640"
        MinHeight="360"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
  <Border x:Name="MainBackground" CornerRadius="12" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12" RowSpacing="8">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="SearchToggleButton" Content="⌕" Click="SearchToggle_OnClick" />
          <Grid x:Name="SearchPanel" Width="320" ColumnDefinitions="*,Auto" IsVisible="False">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search history"
                     TextChanged="SearchBox_OnTextChanged"
                     LostFocus="SearchBox_OnLostFocus" />
            <Button Grid.Column="1" Content="×" Click="SearchClear_OnClick" />
          </Grid>
          <Button x:Name="HistoryFilterButton" Click="HistoryFilter_OnClick" />
          <Button x:Name="FavoritesFilterButton" Click="FavoritesFilter_OnClick" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="MenuButton" Content="⋮" Click="Menu_OnClick" />
          <Popup x:Name="MenuPopup"
                 PlacementTarget="{Binding ElementName=MenuButton}"
                 Placement="Bottom"
                 IsLightDismissEnabled="True">
            <Border x:Name="MenuPopupBorder" Padding="6" CornerRadius="8" Background="#F420242C">
              <StackPanel Spacing="2">
                <Button x:Name="SettingsButton" Click="Settings_OnClick" />
                <Button x:Name="StartupButton" Click="Startup_OnClick" />
                <Button x:Name="ClearButton" Click="Clear_OnClick" />
                <Button x:Name="QuitButton" Click="Quit_OnClick" />
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="HistoryScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      ClipToBounds="False">
          <ListBox x:Name="HistoryList"
                   ItemsSource="{Binding VisibleHistory}"
                   SelectionMode="Multiple"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0,12,0,4"
                   ClipToBounds="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   SelectionChanged="HistoryList_OnSelectionChanged"
                   PointerWheelChanged="HistoryList_OnPointerWheelChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ClipToBounds" Value="False" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
              <Style Selector="Border.history-card">
                <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                <Setter Property="Transitions">
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                  </Transitions>
                </Setter>
              </Style>
              <Style Selector="ListBoxItem:pointerover Border.history-card">
                <Setter Property="RenderTransform" Value="scale(1.03) translateY(-8px)" />
                <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
              </Style>
              <Style Selector="ListBoxItem:selected Border.history-card">
                <Setter Property="BorderBrush" Value="#007AFF" />
                <Setter Property="BorderThickness" Value="3" />
                <Setter Property="RenderTransform" Value="scale(1.03) translateY(-8px)" />
                <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
              </Style>
              <Style Selector="ListBoxItem:selected:pointerover Border.history-card">
                <Setter Property="BorderBrush" Value="#007AFF" />
                <Setter Property="BorderThickness" Value="3" />
                <Setter Property="RenderTransform" Value="scale(1.03) translateY(-8px)" />
                <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="CopyMenuItem" Click="Copy_OnClick" />
                <MenuItem x:Name="FavoriteMenuItem" Click="Favorite_OnClick" />
                <MenuItem x:Name="DeleteMenuItem" Click="Delete_OnClick" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ClipboardHistoryItem">
                <Border Width="292"
                        Height="300"
                        Classes="history-card"
                        Margin="8,8"
                        BorderThickness="0"
                        BorderBrush="Transparent"
                        CornerRadius="12"
                        Background="#F9FFFFFF"
                        BoxShadow="0 0 0 0 #00000000"
                        ClipToBounds="True"
                        DoubleTapped="HistoryItem_OnDoubleTapped">
                  <Grid RowDefinitions="64,*,24">
                    <Border CornerRadius="12,12,0,0" Background="{Binding TypeBrush}">
                      <Grid ColumnDefinitions="*,64">
                        <StackPanel Grid.Column="0" Margin="16,0" VerticalAlignment="Center" Spacing="2">
                          <TextBlock FontSize="20" FontWeight="Medium" Foreground="White" Text="{Binding TypeLabel}" />
                          <TextBlock FontSize="12" Foreground="#DDFFFFFF" Text="{Binding CreateTime, StringFormat='{}{0:g}'}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="White"
                                   Text="{Binding FavoriteMarker}" />
                      </Grid>
                    </Border>
                    <Border Grid.Row="1" Padding="16,12">
                      <Grid>
                        <Image Source="{Binding ImageBitmap}"
                               IsVisible="{Binding IsImage}"
                               Stretch="Uniform"
                               MaxHeight="190"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DisplayPreview}"
                                   IsVisible="{Binding IsTextPreview}"
                                   Foreground="Black"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="190" />
                        <StackPanel IsVisible="{Binding IsFile}"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">
                          <TextBlock Text="{Binding FileDisplayName}"
                                     Foreground="Black"
                                     FontWeight="Medium"
                                     TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis"
                                     TextAlignment="Center"
                                     MaxHeight="80" />
                          <Image Source="avares://OpenClipboard.App/Assets/file.png"
                                 Width="48"
                                 Height="48"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding FileDisplayPath}"
                                     Foreground="#FF555555"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis"
                                     TextAlignment="Center"
                                     MaxHeight="70" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#FF777777"
                               Text="{Binding ItemInfo}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
        <TextBlock x:Name="EmptyHistoryText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="28"
                   FontWeight="Medium"
                   Foreground="#66000000"
                   IsHitTestVisible="False" />
      </Grid>

      <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="11" Opacity="0.65" />
    </Grid>
  </Border>
</Window>
