<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OpenClipboard.App"
        xmlns:models="using:OpenClipboard.App.Models"
        x:Class="OpenClipboard.App.MainWindow"
        x:DataType="local:MainWindow"
        Title="OpenClipboard"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="360">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20" RowSpacing="10">
    <StackPanel Spacing="4">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="OpenClipboard" />
      <TextBlock Opacity="0.7" Text="Clipboard history" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="SearchBox" PlaceholderText="Search history" TextChanged="SearchBox_OnTextChanged" />
      <Button Grid.Column="1" Content="Import old database..." Click="ImportLegacy_OnClick" />
    </Grid>

    <ListBox x:Name="HistoryList"
             Grid.Row="2"
             ItemsSource="{Binding VisibleHistory}"
             SelectionChanged="HistoryList_OnSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:ClipboardHistoryItem">
          <Border Padding="12" Margin="0,0,0,8" CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="72" />
                <TextBlock FontSize="11" Opacity="0.6" Text="{Binding CreateTime, StringFormat='{}{0:g}'}" />
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding FavoriteMarker}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <Button x:Name="CopyButton" Content="Copy" Click="Copy_OnClick" IsEnabled="False" />
      <Button x:Name="FavoriteButton" Content="Favorite" Click="Favorite_OnClick" IsEnabled="False" />
      <Button x:Name="DeleteButton" Content="Delete" Click="Delete_OnClick" IsEnabled="False" />
      <Button Content="Clear all history" Click="Clear_OnClick" />
      <Button x:Name="StartupButton" Content="Enable launch at login" Click="Startup_OnClick" />
      <Button Content="Quit" Click="Quit_OnClick" />
    </StackPanel>

    <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="11" Opacity="0.65" />
  </Grid>
</Window>
